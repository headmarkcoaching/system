# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://academy:academy_dev_password@localhost:5432/parent_first_academy?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
# Port 3200 is intentional — avoids colliding with other local projects that default to :3000.
NEXTAUTH_URL="http://localhost:3200"

# App
NODE_ENV="development"

# ---- Automation & background jobs (optional — see README "Automation & Background Jobs") ----
# Required only to call /api/cron/* (an external scheduler, or the local npm run jobs:* scripts).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# CRON_SECRET=

# ---- WhatsApp / Email / Google (optional — see README "Integrations (WhatsApp, Email, Google)")
# ---- These are all now configurable from the app itself: log in as Super Admin and go to
# ---- Settings -> Integrations. The env vars below are only a fallback for a headless deployment
# ---- with no UI access — anything set in Settings -> Integrations takes priority over these.
# WHATSAPP_PROVIDER=console
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Get these by running: npm run google:connect (see that script's header comment for the
# one-time Google Cloud Console setup it needs first) — or just use Settings -> Integrations.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# ---- AI (optional — see README "AI Study Assistant") ----
# AI_PROVIDER=console
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# ---- Payments (optional — see docs/payment-architecture.md) ----
# PAYMENT_PROVIDER=console

# ---- File storage (optional — also configurable from Settings -> Integrations) ----
# FILE_STORAGE_PROVIDER=local

# ---- Future integration placeholders (not required — see PHASE_COMPLETION.md Known Issues) ----
# ZOOM_API_KEY=
# ZOOM_API_SECRET=
