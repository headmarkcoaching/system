// ==========================================================================
// RBAC
// ==========================================================================

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "students.view", "payments.manage"
  module      String // e.g. "students", "payments" — used to group in the Settings UI
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  roleId       String
  roleKey      RoleKey // denormalized for fast/cheap session + query checks
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  student   Student?
  teacher   Teacher?
  parent    Parent?
  counselor Counselor?

  auditLogs              AuditLog[]         @relation("AuditActor")
  createdRecords         AuditLog[]         @relation("AuditCreatedBy")
  notifications          Notification[]
  studentNotesAuthored   StudentNote[]
  communicationsSent     CommunicationLog[] @relation("CommunicationStaff")
  supportTicketsRaised   SupportTicket[]    @relation("TicketRaisedBy")
  supportTicketsAssigned SupportTicket[]    @relation("TicketAssignedTo")
  aiInteractions         AIInteraction[]

  // Phase 4A
  whatsappMessages        WhatsAppMessage[]
  emailMessages           EmailMessage[]
  smsMessages             SmsMessage[]
  communicationPreference CommunicationPreference?

  // Phase 4B
  analyticsEvents AnalyticsEvent[]

  // Phase 4C
  supportMessagesAuthored  SupportMessage[]
  interventionsResponsible Intervention[]   @relation("InterventionResponsible")
  interventionsCreated     Intervention[]   @relation("InterventionCreatedBy")

  // Phase 3A
  knowledgeDocumentsUploaded KnowledgeDocument[] @relation("KnowledgeDocUploadedBy")
  knowledgeDocumentsReviewed KnowledgeDocument[] @relation("KnowledgeDocReviewedBy")

  // Phase 3D
  goalsCreated StudentGoal[]

  // Phase 3E
  organizationMemberships OrganizationUser[]
  apiKeysCreated          ApiKey[]
  filesUploaded           UploadedFile[]

  // Phase 3F(v)
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// A user requests a reset (by email or phone); if a matching account has an email on file, a
// single-use, expiring, hashed token is emailed to them. Only the hash is ever stored — the raw
// token exists only in the emailed link, same reasoning as never storing a plaintext password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================================================
// PEOPLE
// ==========================================================================

model Student {
  id              String        @id @default(cuid())
  studentCode     String        @unique
  userId          String?       @unique
  fullName        String
  photoUrl        String?
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String?
  whatsapp        String?
  email           String?
  city            String?
  address         String?
  academicLevelId String
  boardId         String?
  groupId         String?
  school          String?
  status          StudentStatus @default(TRIAL)
  statusChangedAt DateTime?
  enrollmentDate  DateTime?
  referralCode    String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?

  user          User?         @relation(fields: [userId], references: [id])
  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id])
  board         Board?        @relation(fields: [boardId], references: [id])
  group         Group?        @relation(fields: [groupId], references: [id])

  parents                 StudentParentRelationship[]
  batchMemberships        BatchStudent[]
  enrollments             Enrollment[]
  attendance              Attendance[]
  liveClassPresence       LiveClassPresence[]
  recordingAccessRequests RecordingAccessRequest[]
  homeworkSubmissions     HomeworkSubmission[]
  notes                   StudentNote[]

  // Phase 2
  testAttempts        TestAttempt[]
  testResults         TestResult[]
  performanceRecords  StudentPerformance[]
  participationScores ParticipationScore[]
  paymentPlans        PaymentPlan[]
  payments            Payment[]

  // Phase 3
  parentReports     ParentReport[]
  communicationLogs CommunicationLog[]
  originatingLead   Lead?

  // Phase 4A
  automationLogs AutomationLog[]

  // Phase 4C
  referredBy            Referral[]            @relation("StudentReferrer")
  convertedFromReferral Referral?             @relation("ReferralConvertedStudent")
  points                StudentPoint[]
  badges                StudentBadge[]
  interventions         Intervention[]
  engagementScores      EngagementScore[]
  predictiveRiskScores  PredictiveRiskScore[]

  // Phase 3D
  contentProgress ContentProgress[]
  goals           StudentGoal[]

  // Notes Subscription
  notesSubscriptions NotesSubscription[]

  @@index([academicLevelId])
  @@index([status])
  @@map("students")
}

model Parent {
  id           String   @id @default(cuid())
  userId       String?  @unique
  fullName     String
  phone        String
  whatsapp     String?
  email        String?
  city         String?
  referralCode String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User?                       @relation(fields: [userId], references: [id])
  children StudentParentRelationship[]

  referredBy Referral[] @relation("ParentReferrer")

  @@map("parents")
}

model StudentParentRelationship {
  id           String           @id @default(cuid())
  studentId    String
  parentId     String
  relationship RelationshipType
  isPrimary    Boolean          @default(false)
  createdAt    DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parent_relationships")
}

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  fullName        String
  phone           String?
  email           String?
  bio             String?
  photoUrl        String?
  qualification   String?
  experienceYears Int?
  specialization  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  batchAssignments BatchTeacher[]
  timetableEntries Timetable[]
  liveClasses      LiveClass[]

  @@map("teachers")
}

model Counselor {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  leads  Lead[]
  trials Trial[]

  @@map("counselors")
}

// ==========================================================================
// ACADEMIC STRUCTURE
// ==========================================================================

model AcademicLevel {
  id        String   @id @default(cuid())
  name      String   @unique // Class 8, Class 9, Class 10, 1st Year, 2nd Year
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students           Student[]
  batches            Batch[]
  subjects           Subject[]
  materials          StudyMaterial[]
  leads              Lead[]
  announcements      Announcement[]
  tests              Test[]
  knowledgeDocuments KnowledgeDocument[]

  @@map("academic_levels")
}

model Board {
  id        String   @id @default(cuid())
  name      String   @unique // Punjab Board, Federal Board, Sindh Board, ...
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students           Student[]
  batches            Batch[]
  leads              Lead[]
  knowledgeDocuments KnowledgeDocument[]

  @@map("boards")
}

model Program {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. Safe at Home, Total Care Management
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     Batch[]
  enrollments Enrollment[]

  @@map("programs")
}

model Group {
  id        String    @id @default(cuid())
  name      String    @unique
  type      GroupType
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students           Student[]
  batches            Batch[]
  leads              Lead[]
  knowledgeDocuments KnowledgeDocument[]

  @@map("groups")
}

model Subject {
  id              String   @id @default(cuid())
  name            String
  academicLevelId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicLevel AcademicLevel? @relation(fields: [academicLevelId], references: [id])

  batchSubjects      BatchSubject[]
  batchTeachers      BatchTeacher[]
  timetableEntries   Timetable[]
  liveClasses        LiveClass[]
  recordings         ClassRecording[]
  homework           Homework[]
  materials          StudyMaterial[]
  tests              Test[]
  attendance         Attendance[]
  knowledgeDocuments KnowledgeDocument[]
  goals              StudentGoal[]
  notesSubscriptions NotesSubscription[]

  @@unique([name, academicLevelId])
  @@map("subjects")
}

// ==========================================================================
// BATCHES & ENROLLMENT
// ==========================================================================

model Batch {
  id                 String      @id @default(cuid())
  name               String
  academicLevelId    String
  boardId            String?
  groupId            String?
  programId          String?
  maxStudents        Int         @default(30)
  startDate          DateTime
  endDate            DateTime?
  status             BatchStatus @default(UPCOMING)
  leaderboardEnabled Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdById        String?

  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id])
  board         Board?        @relation(fields: [boardId], references: [id])
  group         Group?        @relation(fields: [groupId], references: [id])
  program       Program?      @relation(fields: [programId], references: [id])

  students            BatchStudent[]
  teachers            BatchTeacher[]
  subjects            BatchSubject[]
  enrollments         Enrollment[]
  timetableEntries    Timetable[]
  liveClasses         LiveClass[]
  recordings          ClassRecording[]
  homework            Homework[]
  attendance          Attendance[]
  announcements       Announcement[]
  trials              Trial[]
  tests               Test[]
  performanceRecords  StudentPerformance[]
  participationScores ParticipationScore[]

  @@index([status])
  @@map("batches")
}

model BatchStudent {
  id        String   @id @default(cuid())
  batchId   String
  studentId String
  joinedAt  DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@map("batch_students")
}

model BatchTeacher {
  id        String   @id @default(cuid())
  batchId   String
  teacherId String
  subjectId String?
  createdAt DateTime @default(now())

  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@unique([batchId, teacherId, subjectId])
  @@map("batch_teachers")
}

model BatchSubject {
  id        String   @id @default(cuid())
  batchId   String
  subjectId String
  createdAt DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([batchId, subjectId])
  @@map("batch_subjects")
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  batchId        String
  programId      String?
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id])

  @@unique([studentId, batchId])
  @@map("enrollments")
}

// ==========================================================================
// SCHEDULING & CONTENT
// ==========================================================================

model Timetable {
  id        String    @id @default(cuid())
  batchId   String
  subjectId String
  teacherId String
  dayOfWeek DayOfWeek
  startTime String // "HH:mm" 24h
  endTime   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([batchId, dayOfWeek])
  @@map("timetables")
}

model LiveClass {
  id              String          @id @default(cuid())
  title           String
  subjectId       String
  chapter         String?
  batchId         String
  teacherId       String
  scheduledDate   DateTime
  startTime       String
  endTime         String
  meetingProvider MeetingProvider @default(CUSTOM)
  meetingLink     String
  // Set only when meetingProvider is GOOGLE_MEET and the link was auto-created via the Calendar
  // API — lets a later edit/cancel update or delete the same Calendar event instead of orphaning it.
  googleEventId   String?
  status          LiveClassStatus @default(UPCOMING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String?

  subject Subject @relation(fields: [subjectId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  attendance Attendance[]
  recordings ClassRecording[]
  presence   LiveClassPresence[]

  @@index([batchId, scheduledDate])
  @@index([status])
  @@map("live_classes")
}

model ClassRecording {
  id            String   @id @default(cuid())
  title         String
  liveClassId   String?
  subjectId     String
  batchId       String
  chapter       String?
  recordingDate DateTime
  recordingUrl  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  liveClass LiveClass? @relation(fields: [liveClassId], references: [id])
  subject   Subject    @relation(fields: [subjectId], references: [id])
  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  accessRequests RecordingAccessRequest[]

  @@map("class_recordings")
}

// A student's time-boxed unlock of one recording — created only when they request it, and only
// when eligible (their Attendance for the linked LiveClass was ABSENT/PARTIAL/EXCUSED). A
// recording with no liveClassId (legacy, uploaded before this was required) has no eligibility
// signal to check and stays open the old way — see RecordingItem's NOT_LINKED case.
model RecordingAccessRequest {
  id          String   @id @default(cuid())
  recordingId String
  studentId   String
  requestedAt DateTime @default(now())
  expiresAt   DateTime

  recording ClassRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([recordingId, studentId])
  @@map("recording_access_requests")
}

model StudyMaterial {
  id              String       @id @default(cuid())
  title           String
  type            MaterialType
  academicLevelId String
  subjectId       String
  chapter         String?
  // Legacy external link — kept only for material uploaded before the switch to hosted files
  // below; still opens directly with no view-only/no-download protection, same "isLinked"
  // legacy-fallback shape ClassRecording already uses. Every new upload sets fileId instead.
  fileUrl         String?
  fileId          String?      @unique
  uploadedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  academicLevel AcademicLevel @relation(fields: [academicLevelId], references: [id])
  subject       Subject       @relation(fields: [subjectId], references: [id])
  file          UploadedFile? @relation(fields: [fileId], references: [id])

  @@index([academicLevelId, subjectId])
  @@map("study_materials")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

// A parent's opt-in postal-mail subscription for one student's one subject — the academy prints
// and mails that subject's notes to the delivery address on file once a month's payment clears.
// One row per (student, subject); NotesSubscriptionPayment holds the month-by-month billing and
// shipment record against it.
model NotesSubscription {
  id              String             @id @default(cuid())
  studentId       String
  subjectId       String
  status          SubscriptionStatus @default(ACTIVE)
  // Snapshot at subscribe time — the price list can change later without rewriting history.
  pricePerMonth   Decimal            @db.Decimal(10, 2)
  deliveryName    String
  deliveryAddress String
  deliveryCity    String
  deliveryPhone   String
  subscribedAt    DateTime           @default(now())
  cancelledAt     DateTime?
  createdById     String?

  student  Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject                    @relation(fields: [subjectId], references: [id])
  payments NotesSubscriptionPayment[]

  @@unique([studentId, subjectId])
  @@map("notes_subscriptions")
}

// One row per billing month for a subscription — mirrors Payment's own PENDING->PAID/REJECTED
// self-reported-then-staff-verified shape exactly, plus the two fields tuition payments don't
// need: which month this covers, and whether the academy has actually mailed it yet.
model NotesSubscriptionPayment {
  id              String         @id @default(cuid())
  subscriptionId  String
  monthLabel      String
  amount          Decimal        @db.Decimal(10, 2)
  method          PaymentMethod?
  referenceNumber String?
  receiptFileId   String?
  status          PaymentStatus  @default(PENDING)
  submittedAt     DateTime       @default(now())
  verifiedAt      DateTime?
  verifiedById    String?
  shippedAt       DateTime?
  trackingNote    String?
  createdAt       DateTime       @default(now())

  subscription NotesSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
