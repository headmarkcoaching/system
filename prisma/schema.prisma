  @@index([ruleKey])
  @@index([studentId])
  @@index([leadId])
  @@map("automation_logs")
}

model MessageTemplate {
  id                   String             @id @default(cuid())
  key                  MessageTemplateKey @unique
  name                 String
  body                 String
  isActive             Boolean            @default(true)
  // Nullable: a rule only sends email once staff fill these in — same convention as WhatsApp's
  // isActive gate, but per-channel, since not every academy wants every rule on every channel.
  emailSubject         String?
  emailBody            String?
  // Meta WhatsApp Cloud API requires a pre-approved template name for any business-initiated
  // message sent outside a customer's 24h session window — plain body text alone gets rejected.
  // Set once the template is approved in Meta Business Manager; leave null to keep sending as
  // freeform text (fine for testing or session-window replies, but Meta will reject it otherwise).
  metaTemplateName     String?
  metaTemplateLanguage String             @default("en")
  updatedAt            DateTime           @updatedAt
  updatedById          String?

  whatsappMessages WhatsAppMessage[]
  emailMessages    EmailMessage[]

  @@map("message_templates")
}

model WhatsAppMessage {
  id                String              @id @default(cuid())
  recipientPhone    String
  recipientUserId   String?
  templateKey       MessageTemplateKey?
  relatedEntityType String?
  relatedEntityId   String?
  body              String
  // The raw values `body` was rendered from — kept so a Meta template send can be rebuilt as
  // positional {{1}}, {{2}}... parameters at send time without re-deriving them from callers.
  variables         Json?
  status            WhatsAppStatus      @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedReason      String?
  createdAt         DateTime            @default(now())

  recipientUser User?            @relation(fields: [recipientUserId], references: [id])
  template      MessageTemplate? @relation(fields: [templateKey], references: [key])

  @@index([status])
  @@index([recipientUserId])
  @@map("whatsapp_messages")
}

model EmailMessage {
  id                String              @id @default(cuid())
  recipientEmail    String
  recipientUserId   String?
  templateKey       MessageTemplateKey?
  relatedEntityType String?
  relatedEntityId   String?
  subject           String
  body              String
  status            EmailStatus         @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  failedReason      String?
  createdAt         DateTime            @default(now())

  recipientUser User?            @relation(fields: [recipientUserId], references: [id])
  template      MessageTemplate? @relation(fields: [templateKey], references: [key])

  @@index([status])
  @@index([recipientUserId])
  @@map("email_messages")
}

// Manual-send only (no automation rule drives this, and no MessageTemplate.smsBody field exists
// to template against) — a staff-composed campaign body, sent through a console-only provider
// since no real SMS provider is configured anywhere in this app yet.
model SmsMessage {
  id                String      @id @default(cuid())
  recipientPhone    String
  recipientUserId   String?
  relatedEntityType String?
  relatedEntityId   String?
  body              String
  status            EmailStatus @default(QUEUED)
  providerMessageId String?
  sentAt            DateTime?
  failedReason      String?
  createdAt         DateTime    @default(now())

  recipientUser User? @relation(fields: [recipientUserId], references: [id])

  @@index([status])
  @@index([recipientUserId])
  @@map("sms_messages")
}

// Single-row settings table (see AIUsageConfig/PerformanceConfig for the same "singleton"
// pattern) letting the Super Admin manage every external integration's live credentials from
// the UI instead of editing .env and redeploying. Secret-bearing fields (marked below) are
// encrypted at rest via src/lib/crypto.ts, keyed off AUTH_SECRET — a DB dump alone doesn't leak
// a live WhatsApp/SMTP/Google credential. Every provider factory (whatsapp/email/googlemeet/
// storage) checks this row first and falls back to the equivalent env var when a field is
// unset, so an existing .env-only deployment keeps working unchanged.
model IntegrationSettings {
  id String @id @default("singleton")

  whatsappProvider    WhatsAppProviderType @default(CONSOLE)
  metaWhatsappToken   String? // encrypted
  metaWhatsappPhoneId String?
  twilioAccountSid    String?
  twilioAuthToken     String? // encrypted
  twilioWhatsappFrom  String?

  emailProvider EmailProviderType @default(CONSOLE)
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPassword  String? // encrypted
  smtpFrom      String?

  // One Google OAuth connection powers both Google Meet (Calendar API) and Google Drive
  // storage — a real academy uses one Google account for both, and it halves the OAuth
  // consent/setup work vs. connecting each separately.
  googleClientId       String?
  googleClientSecret   String? // encrypted
  googleRefreshToken   String? // encrypted
  googleConnectedEmail String?
  googleCalendarId     String?
  googleConnectedAt    DateTime?

  fileStorageProvider FileStorageProviderType @default(LOCAL)

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("integration_settings")
}

model CommunicationPreference {
  id              String   @id @default(cuid())
