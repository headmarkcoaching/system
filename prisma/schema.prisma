  attachmentUrl    String?
  attachmentFileId String?
  status           SupportStatus   @default(OPEN)
  priority         SupportPriority @default(MEDIUM)
  assignedToId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  raisedBy       User          @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedTo     User?         @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  attachmentFile UploadedFile? @relation(fields: [attachmentFileId], references: [id])

  messages SupportMessage[]

  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(cuid())
  ticketId      String
  authorId      String
  message       String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@map("support_messages")
}

model Intervention {
  id                 String             @id @default(cuid())
  studentId          String
  reason             String
  actionPlan         String
  responsibleStaffId String
  startDate          DateTime
  reviewDate         DateTime
  status             InterventionStatus @default(OPEN)
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  responsibleStaff User    @relation("InterventionResponsible", fields: [responsibleStaffId], references: [id])
  createdBy        User    @relation("InterventionCreatedBy", fields: [createdById], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("interventions")
}

model EngagementScore {
  id                     String           @id @default(cuid())
  studentId              String
  score                  Float
  status                 EngagementStatus
  attendanceComponent    Float
  homeworkComponent      Float
  loginComponent         Float
  testComponent          Float
  participationComponent Float
  calculatedAt           DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("engagement_scores")
}

// ==========================================================================
// Phase 3C: Advanced Learning Analytics, Cohort Analytics, Predictive Risk
// ==========================================================================

model PredictiveRiskScore {
  id                       String    @id @default(cuid())
  studentId                String
  score                    Float
  riskLevel                RiskLevel
  attendanceTrendComponent Float
  homeworkTrendComponent   Float
  testTrendComponent       Float
  engagementComponent      Float
  inactivityComponent      Float
  signals                  Json
  calculatedAt             DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([riskLevel])
  @@map("predictive_risk_scores")
}

// ==========================================================================
// Phase 3D: Learning Experience (watch progress, learning paths, goals, exam prep)
// ==========================================================================

enum ContentKind {
  RECORDING
  STUDY_MATERIAL
}

// Per-student consumption progress for a piece of content, keyed loosely by (contentKind,
// contentId) rather than a real FK to two different tables — same polymorphic-reference idiom
// AuditLog already uses (entityType/entityId as plain strings), not a novel pattern. Serves two
// purposes: real watch-progress/resume for RECORDING (when the URL is a directly embeddable
// video file the browser can report timeupdate events for) and a self-reported "read" marker
// for STUDY_MATERIAL (there's no way to detect whether a student actually read a PDF/notes
// link, so that one is always a manual toggle, same honesty precedent as other self-report
// flows in this app). Both also feed Learning Path step completion (learning-path.ts).
model ContentProgress {
  id                  String      @id @default(cuid())
  studentId           String
  contentKind         ContentKind
  contentId           String
  lastPositionSeconds Int         @default(0)
  completionPercent   Int         @default(0)
  completed           Boolean     @default(false)
  startedAt           DateTime    @default(now())
  completedAt         DateTime?
  updatedAt           DateTime    @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentKind, contentId])
  @@index([studentId])
  @@map("content_progress")
}

enum GoalType {
  WEEKLY
  MONTHLY
  EXAM
}

enum GoalMetric {
  SUBJECT_TEST_SCORE
  OVERALL_PERFORMANCE
  ATTENDANCE
  HOMEWORK_COMPLETION
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  MISSED
  CANCELLED
}

// currentValue is deliberately NOT stored — goals.ts recomputes it live from the same
// services Performance/Analytics already use (getStudentAverageTestScore, getLatestPerformance,
// computeAttendanceRate, computeHomeworkCompletionRate) so a goal can never silently drift out
// of sync with the real numbers it's tracking.
model StudentGoal {
  id          String     @id @default(cuid())
  studentId   String
  type        GoalType
  metric      GoalMetric
  subjectId   String?
  title       String
  startValue  Float
  targetValue Float
  startDate   DateTime
  targetDate  DateTime
  status      GoalStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("student_goals")
}

// ==========================================================================
// Phase 3A: AI Foundation & Knowledge Base
// ==========================================================================

model AIInteraction {
  id               String               @id @default(cuid())
  userId           String?
  conversationId   String
  feature          AIInteractionFeature @default(STUDY_ASSISTANT)
  provider         String
  model            String
  prompt           String
  response         String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  status           AIInteractionStatus
  errorMessage     String?
  createdAt        DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId])
  @@index([status])
  @@map("ai_interactions")
}

model KnowledgeDocument {
  id              String             @id @default(cuid())
  title           String
  docType         KnowledgeDocType
  academicLevelId String?
  boardId         String?
  groupId         String?
  subjectId       String?
  chapter         String?
  topic           String?
  sourceUrl       String?
  content         String
  status          KnowledgeDocStatus @default(PENDING_REVIEW)
  uploadedById    String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  academicLevel AcademicLevel? @relation(fields: [academicLevelId], references: [id])
  board         Board?         @relation(fields: [boardId], references: [id])
  group         Group?         @relation(fields: [groupId], references: [id])
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  uploadedBy    User           @relation("KnowledgeDocUploadedBy", fields: [uploadedById], references: [id])
  reviewedBy    User?          @relation("KnowledgeDocReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([academicLevelId])
  @@index([subjectId])
  @@map("knowledge_documents")
}

// ==========================================================================
// Phase 3E: Platform Scalability & Security
// ==========================================================================

// Schema-only multi-tenant groundwork — zero rows, zero wiring into any existing query,
// same precedent as Phase 1's Phase-2/3 stub models (Test, Lead, etc. once were). The spec's
// own instruction is "do not break the current single-academy implementation," so every
// existing service/query stays exactly as-is; these three models exist purely so a future
// multi-academy phase doesn't need a risky reshape of live tables to retrofit tenancy.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings OrganizationSettings?
  members  OrganizationUser[]

  @@map("organizations")
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  timezone       String   @default("Asia/Karachi")
  currency       String   @default("PKR")
  branding       Json?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_users")
}

// Bearer-token auth for the new /api/v1/* surface — a separate credential from a user's own
// session, since an external mobile app/integration is a different caller than a logged-in
// browser. Only the hash is ever stored (same "never store the real secret" precedent as
// password hashing) — the real key is shown to the creator exactly once, at creation time.
model ApiKey {
  id          String    @id @default(cuid())
  label       String
  keyHash     String    @unique
  keyPrefix   String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@map("api_keys")
}

enum FilePurpose {
  HOMEWORK_SUBMISSION
  SUPPORT_ATTACHMENT
  PAYMENT_RECEIPT
  PROFILE_PHOTO
  LEAD_ASSESSMENT
  STUDY_MATERIAL
  NOTES_SUBSCRIPTION_RECEIPT
}

// Provider-agnostic file metadata (src/lib/storage/*) — mirrors the WhatsApp/AI provider
// abstraction pattern exactly: an interface, a real zero-config default (LocalFileStorageProvider,
// which genuinely writes to local disk — unlike AI/WhatsApp, no paid API key is needed for a
// working default here), and room for a future S3/Supabase Storage provider behind the same
// interface. storagePath is provider-specific (a local file path today; would be an object key
// for a cloud provider) and is never exposed directly — access always goes through
// /api/files/[id], which re-checks the same access rule as the owning record.
model UploadedFile {
  id              String      @id @default(cuid())
  filename        String
  mimeType        String
  sizeBytes       Int
  storageProvider String      @default("local")
  storagePath     String
  purpose         FilePurpose
  uploadedById    String
  createdAt       DateTime    @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  homeworkSubmissions       HomeworkSubmission[]
  supportTickets            SupportTicket[]
  payments                  Payment[]
  studyMaterial             StudyMaterial?
  notesSubscriptionPayments NotesSubscriptionPayment[]

  @@index([purpose])
  @@index([uploadedById])
  @@map("uploaded_files")
}

// Persists every scheduled-job run's outcome — the real gap found during this phase's
// inspect-first pass: /api/cron/[job] already caught and returned job errors in its HTTP
// response, but nothing persisted that outcome anywhere queryable, so a failure called by an
// external scheduler with nobody watching the response body was effectively invisible.
model JobRun {
  id             String           @id @default(cuid())
  jobKey         String
  status         AutomationStatus
  itemsProcessed Int?
  errorMessage   String?
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?

  @@index([jobKey])
  @@index([status])
  @@map("job_runs")
}

// Singleton config (same pattern as PerformanceConfig/PointsConfig) preparing for future cost
// controls on AI usage, per the spec's own "prepare for cost controls" wording — a soft,
// informational cap surfaced as a dashboard warning, not hard enforcement (no billing/metering
// integration exists to actually block a request).
model AIUsageConfig {
  id                       String   @id @default("singleton")
  dailyTokenSoftCap        Int?
  costPerThousandTokensUsd Float    @default(0)
  updatedById              String?
  updatedAt                DateTime @updatedAt

  @@map("ai_usage_config")
}
