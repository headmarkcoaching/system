// Parent-First Online Academy — full data model.
// Phase 1 models are actively used by the app. Phase 2/3 and "future-ready" models
// are defined now (per architecture requirements) but have no UI yet — see PHASE_COMPLETION.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

